# Dev image: runs the CRA dev server with hot reload.
# Your source code is mounted in from the host (see docker-compose.yml),
# so this image only needs to install dependencies once.
FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
RUN npm ci

# App code is bind-mounted at runtime via docker-compose, this COPY
# just ensures the image is runnable standalone too (e.g. `docker run`)
COPY . .

EXPOSE 3000
CMD ["npm", "start"]
